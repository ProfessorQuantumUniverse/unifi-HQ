# Lagezentrum – Einstellungen. Nach Änderungen: docker compose up -d

# --- Netz ---------------------------------------------------------------
# Öffentliche IPv4 deines UCG Max (setup trägt sie automatisch ein). Mehrere kommagetrennt.
# Ändert sie sich, werden Flows ohne erkennbar lokale Seite trotzdem als „raus“ gewertet;
# aktualisieren lohnt sich trotzdem, damit „rein“ und Geräte-Namen stimmen.
WAN_IP=

# Weitere eigene Netze, kommagetrennt, z. B. dein IPv6-Präfix vom Provider (2003:ab:cd00::/56).
# RFC1918, CGNAT, Link-Local und ULA sind immer lokal.
LOCAL_EXTRA_NETS=

# Wer NetFlow und Syslog schicken darf (IPs oder CIDRs, kommagetrennt).
# Leer = jede private Adresse. Empfohlen: die LAN-IP des Gateways, z. B. 10.37.10.1
ALLOWED_SENDERS=

# Ports, auf denen bei dir Dienste von außen erreichbar sind (Portfreigaben, VPN-Server).
# Nur Verbindungen auf diese Ports (und klassische Ports < 1024) gelten als „rein“.
# 51820 = WireGuard-Server des UCG. Kommagetrennt.
LOCAL_SERVER_PORTS=51820

# Flows von/zu diesen IPs ignorieren (z. B. die IP dieses LXC), kommagetrennt
IGNORE_IPS=

# --- Dashboard ----------------------------------------------------------
HTTP_PORT=8080
# Wer das Dashboard öffnen darf. Caddy-Syntax, leerzeichengetrennt:
# private_ranges = 10/8, 172.16/12, 192.168/16, 127/8, fd00::/8, ::1
ALLOWED_CLIENTS=private_ranges
# Login: setzt ./lagezentrum.sh password (nicht von Hand eintragen). Leer = kein Login,
# dann sieht jeder im LAN das Dashboard.
AUTH_PASSWORD_HASH=
# Schlüssel für die Sitzungs-Cookies, legt setup bzw. password automatisch an.
# Neuer Schlüssel = alle Browser abgemeldet (./lagezentrum.sh password logout).
AUTH_SECRET=
# Standort auf dem Globus (Ziel bzw. Start der Bögen) – keine Anführungszeichen in den Texten
HOME_LAT=50.11
HOME_LON=8.68
HOME_LABEL=Frankfurt
GATEWAY_NAME=QuantumGateway

# --- Historie -----------------------------------------------------------
# Maximale Dauer und maximaler Platz (was zuerst erreicht ist)
RETENTION=90d
MAX_DISK=20GiB

TZ=Europe/Berlin

# --- Feintuning (meist nicht nötig) ------------------------------------
# Worker-Threads für Vector. 1 ist am sparsamsten; erst bei sehr vielen Flows erhöhen.
VECTOR_THREADS=1
